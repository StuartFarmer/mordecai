# Hex escrow — the L1 half of the hex demo. Both players stake the same
# amount of CAI into a pot keyed by the game id (the same client-side
# code hash the app-chain Hex contract uses); the winner takes all. Only
# the game's derived app address may settle, via the app chain's anchored
# outcome call (app-chains spec §2.1) — no bridge, no wrapped assets.

contract HexEscrow:

    config:
        game: address

    state Pot[int]:
        creator: address
        opponent: address
        stake: int
        # 0 open (creator staked), 1 active (both staked), 2 closed
        phase: int = 0

    action create(game_id: int):
        require(value > 0, "attach your stake")
        require(not exists(Pot[game_id]), "game code already taken")
        Pot[game_id] = Pot(creator=sender, opponent=sender, stake=value)
        emit("pot opened")

    action join(game_id: int):
        require(exists(Pot[game_id]), "no such pot")
        p = Pot[game_id]
        require(p.phase == 0, "pot is not open")
        require(sender != p.creator, "cannot stake against yourself")
        require(value == p.stake, "attached value must match the creator's stake")
        p.opponent = sender
        p.phase = 1
        emit("pot funded")

    action cancel(game_id: int):
        require(exists(Pot[game_id]), "no such pot")
        p = Pot[game_id]
        require(p.phase == 0, "pot already funded")
        require(sender == p.creator, "only the creator can cancel")
        p.phase = 2
        transfer(p.creator, p.stake)
        emit("pot cancelled")

    action settle(game_id: int, winner: address):
        require(sender == config.game, "only the game may settle")
        require(exists(Pot[game_id]), "no such pot")
        p = Pot[game_id]
        require(p.phase == 1, "pot is not active")
        require(winner == p.creator or winner == p.opponent,
                "winner must be one of the players")
        p.phase = 2
        transfer(winner, p.stake + p.stake)
        emit("pot paid out")
