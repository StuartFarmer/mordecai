#!/usr/bin/env python3
"""mordecaic — the Mordecai Pythonic contract compiler (spec §21).

Usage:
  mordecaic check <contract.pysc>
  mordecaic build <contract.pysc> -o <outdir> [--runtime-path <path>] [--wasm]

`build` emits a cargo project; `--wasm` also runs cargo (wasm32 target)
and copies the artifact to <outdir>/<name>.wasm.
"""
import argparse
import pathlib
import shutil
import subprocess
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

from mordecaidsl import check, generate, parse  # noqa: E402
from mordecaidsl.codegen import snake  # noqa: E402
from mordecaidsl.errors import DslError  # noqa: E402

DEFAULT_RUNTIME = pathlib.Path(__file__).resolve().parent.parent / "contracts" / "runtime-rs"


def load(path: str):
    program = parse(pathlib.Path(path).read_text())
    check(program)
    return program


def main() -> int:
    ap = argparse.ArgumentParser(prog="mordecaic")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p_check = sub.add_parser("check")
    p_check.add_argument("file")
    p_build = sub.add_parser("build")
    p_build.add_argument("file")
    p_build.add_argument("-o", "--out", required=True)
    p_build.add_argument("--runtime-path", default=str(DEFAULT_RUNTIME))
    p_build.add_argument("--wasm", action="store_true")
    args = ap.parse_args()

    try:
        program = load(args.file)
    except DslError as err:
        print(f"error: {err}", file=sys.stderr)
        return 1

    if args.cmd == "check":
        print(f"ok: contract {program.name} "
              f"({len(program.actions)} actions, {len(program.states)} states)")
        return 0

    out = pathlib.Path(args.out)
    files = generate(program, str(pathlib.Path(args.runtime_path).resolve()))
    for rel, contents in files.items():
        target = out / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(contents)
    print(f"emitted {out}/Cargo.toml, {out}/src/lib.rs")

    if args.wasm:
        name = snake(program.name)
        subprocess.run(
            ["cargo", "build", "--release", "--target", "wasm32-unknown-unknown"],
            cwd=out, check=True,
        )
        artifact = out / "target/wasm32-unknown-unknown/release" / f"{name}.wasm"
        shutil.copy(artifact, out / f"{name}.wasm")
        print(f"built {out}/{name}.wasm")
    return 0


if __name__ == "__main__":
    sys.exit(main())
