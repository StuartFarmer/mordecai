{
  "name": "mordecai-platform",
  "private": true,
  "type": "module",
  "bin": {
    "mordecai": "./bin/mordecai.mjs"
  },
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "mordecai": "node bin/mordecai.mjs",
    "build": "tsc -b && node scripts/build-node-web.mjs && node scripts/build-site.mjs",
    "build:docs": "node scripts/build-site.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:site": "pnpm --filter @mordecai/gateway dev:site",
    "check:site": "node scripts/check-site.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.20.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@hyperswarm/rpc": "^3.5.0"
  }
}
