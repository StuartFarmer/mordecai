{
  "name": "@mordecai/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-facing HTTP gateway: JSON/HTTP bridge to hyperswarm node RPC plus static frontend serving",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mordecai-gateway": "dist/cli.js"
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsc -b && node ../../scripts/build-node-web.mjs && node ../../scripts/build-site.mjs",
    "test": "vitest run",
    "build:web": "vite build --config vite.config.js",
    "dev:site": "astro dev --config astro.config.mjs"
  },
  "dependencies": {
    "@mordecai/crypto": "workspace:*",
    "@mordecai/protocol": "workspace:*",
    "@mordecai/rpc": "workspace:*",
    "@mordecai/wallet": "workspace:*",
    "chess.js": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/mdx": "8.1.1",
    "@mordecai/chain": "workspace:*",
    "@mordecai/node": "workspace:*",
    "astro": "7.4.2",
    "hyperdht": "^6.32.0",
    "pagefind": "1.5.2",
    "prettier-plugin-astro": "1.1.2",
    "vite": "^5.4.11"
  }
}
