---
import { Content as Explorer } from '../content/explorer.mdx';
import { Content as Apps } from '../content/apps.mdx';
---

<section data-page="explorer" class="chain-browser" aria-labelledby="explorer-title" hidden>
  <h1 id="explorer-title" tabindex="-1">
    Explorer
  </h1>
  <Explorer />
  <div id="explorer-content" class="intro"></div>
