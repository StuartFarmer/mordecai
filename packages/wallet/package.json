{
  "name": "@mordecai/wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wallet: key management, transaction signing, keystore files, and CLI",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./chess": {
      "types": "./dist/chess.d.ts",
      "default": "./dist/chess.js"
    }
  },
  "bin": {
    "mordecai-wallet": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@mordecai/crypto": "workspace:*",
    "@mordecai/protocol": "workspace:*",
    "@noble/curves": "^1.6.0",
    "z32": "^1.1.0",
    "@noble/hashes": "^1.5.0",
    "chess.js": "^1.4.0"
  }
}
